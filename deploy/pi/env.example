# solar-monitor collector на слабом ARM (Pi 1 / Zero): без Docker, без Influx/Grafana
SITE=pi
DEVICE_NAME=Inverter
DEVICE_MODEL=PI30 inverter

# --- Транспорт: выберите ОДИН ---------------------------------------------
# 1) USB-RS232 / RS485 адаптер (физический кабель к инвертору):
#TRANSPORT=serial
#SERIAL_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
#SERIAL_BAUD=2400

# 2) Донгл EW10 / ser2net / ESP32-шлюз по сети:
TRANSPORT=tcp
TCP_HOST=192.168.31.110
TCP_PORT=9999

# 3) USB-HID (инвертор нативно, без переходника):
#TRANSPORT=hid
#HID_DEVICE=/dev/hidraw0

# --- MQTT -----------------------------------------------------------------
MQTT_HOST=192.168.31.224
MQTT_PORT=1883
MQTT_USER=gerkules
MQTT_PASS=changeme

API_PORT=8080
API_HOST=0.0.0.0

# КРИТИЧНО для ARMv6: дефолтные 5 с дают ~22% CPU, 10 с — ~3%
POLL_INTERVAL=10
