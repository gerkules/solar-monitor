[Unit]
Description=Solar Monitor Collector — дополнительный инвертор (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=solar
Group=solar
# /dev/ttyUSB* (USB-RS232/RS485) и /dev/hidraw* (нативный USB инвертора)
SupplementaryGroups=dialout
WorkingDirectory=/opt/solar-monitor/collector
# Общие настройки — из основного .env, отличия — из sites/<id>.env
# (второй файл перекрывает первый; см. страницу «Инверторы» в UI).
EnvironmentFile=-/opt/solar-monitor/.env
EnvironmentFile=/opt/solar-monitor/sites/%i.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/solar-monitor/venv/bin/python -m solar_monitor.main
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
