# Шаблон настроек узла. Скопировать на телефон рядом с start-collector.sh:
#   /root/solar-monitor.env  (внутри Debian), затем в start-collector.sh:
#   . /root/solar-monitor.env
#
# Пароли сюда НЕ писать в git — заполнять на телефоне.

# --- площадка ---------------------------------------------------------------
# имя сайта: попадёт в MQTT-префикс и в HA-сущности (solar_<site>_*)
SITE=friend

# --- брокер ----------------------------------------------------------------
# Вариант «локальный брокер на телефоне» (автономно, без интернета):
MQTT_HOST=127.0.0.1
# Вариант «публиковать на NAS владельца» (нужен туннель/проброс):
#MQTT_HOST=192.168.1.224
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# --- источник кадров PI30 --------------------------------------------------
# Мост на Wemos/ESP8266 (прозрачный TCP ⇄ RS232, порт 9999):
TRANSPORT=tcp
TCP_HOST=192.168.4.1
TCP_PORT=9999
# Прямой донгл EW10:
#TCP_HOST=192.168.31.110
# Донгл в MQTT-режиме (делит топик с другими поллерами — вторым не запускать):
#TRANSPORT=mqtt
#TRANS_TOPIC=inverter/

# --- web UI ----------------------------------------------------------------
WEBAPP=true
API_PORT=8080
POLL_INTERVAL=10
# Обязательно, если в сети есть кто-то кроме владельца:
#AUTH_PASSWORD=сменить_меня
#AUTH_USER=admin

# --- если на телефоне появится InfluxDB (arm64) ----------------------------
#INFLUX_MODE=2
#INFLUX_URL=http://127.0.0.1:8086
#INFLUX_TOKEN=
#INFLUX_ORG=solar
#INFLUX_BUCKET=solar
