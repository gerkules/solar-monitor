# ---------------------------------------------------------------------------
# solar-monitor — образец конфигурации.
# Скопируйте в .env и заполните, либо запустите ./tools/deploy.sh — он сгенерирует секреты.
# Значения-заглушки (change-me…) обязательно заменить; сам .env в git не попадает.
# ---------------------------------------------------------------------------

# выбор подключения, сделанный в UI, хранится здесь и перекрывает TRANSPORT
CONNECTION_FILE=/data/connection.json

# ---- identity --------------------------------------------------------------
SITE=office                     # short id; also an InfluxDB tag and MQTT prefix
DEVICE_NAME=Inverter (office)
DEVICE_MODEL=Axpert 11kW
ENTITY_PREFIX=solar_office      # prefix for HA entity ids: sensor.solar_office_pv_power
TEMP_UNIT=C

# ---- inverter connection ---------------------------------------------------
# hid     -> native inverter USB port (needs devices: /dev/hidraw0 in compose)
# serial  -> USB-RS232 / RS485 adapter (needs devices: /dev/ttyUSB0 in compose)
# tcp     -> EW10 dongle :9999, ser2net, ESP32 gateway, usbip (works on a VDS)
# mqtt    -> EW10 in MQTT-socket mode (publish frame, read reply from a topic)
TRANSPORT=tcp

# sa-mqtt: импорт уже работающей SolarAssistant (её USB-порт занят, читаем MQTT)
#   TRANSPORT=sa-mqtt
SA_MQTT_HOST=192.168.1.70
SA_MQTT_PORT=1883
SA_MQTT_USER=
SA_MQTT_PASS=

# tcp
TCP_HOST=192.168.1.70
TCP_PORT=9999

# serial
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=2400

# usb-hid: either a hidraw node (no extra libs) or vendor:product via hidapi
HID_DEVICE=/dev/hidraw0
HID_VID=0x0665
HID_PID=0x5161
HID_REPORT_ID=0

# mqtt transport (EW10 socket mode only)
TRANS_TOPIC=inverter/

# ---- polling ---------------------------------------------------------------
POLL_INTERVAL=5
QMOD_INTERVAL=60
QPIRI_INTERVAL=600
QPIWS_INTERVAL=60          # 0 = do not poll warnings
QBMS_INTERVAL=60           # данные BMS, которые инвертор читает по CAN/RS485 (QBMS)
BATTERY_TYPE_ROLLBACK=true      # откат протокола BMS, если связь с АКБ пропала
BATTERY_TYPE_ROLLBACK_AFTER=90  # сколько секунд ждать подтверждения связи
HAS_MPPT2=true             # second MPPT (QPIGS2)
OFFLINE_AFTER=120
GRID_DEADBAND=50
ALLOW_SETTINGS=true        # false = read-only monitoring

# ---- mqtt broker (publish) -------------------------------------------------
MQTT_HOST=192.168.1.80
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TLS=false
MQTT_PREFIX=solar/office       # <SITE_ROOT>/<SITE>; одна Ui видит все сайты
# SITE_ROOT=solar              # по умолчанию = родитель MQTT_PREFIX
STATE_RETAIN=true              # держать последнее состояние сайта на брокере
SITE_TTL=900                   # забыть сайт, который молчит N секунд
HA_DISCOVERY_PREFIX=homeassistant

# ---- influxdb 2.x ----------------------------------------------------------
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=solar
INFLUX_BUCKET=solar
INFLUX_RETENTION=30d                # raw samples (10 s) -> 30 days
INFLUX_MEASUREMENT_PREFIX=

# ---- battery monitoring (как в SolarAssistant: выбор источника данных АКБ) ---
# inverter | emulated | jbd | pylontech | modbus | vedirect | can
BATTERY_CONFIG_FILE=/data/battery.json   # выбор из UI хранится здесь и важнее env
BATTERY_SOURCE=inverter
BATTERY_CAPACITY_AH=            # для emulated: ёмкость АКБ, А·ч
BATTERY_NOMINAL_V=48
BMS_PORT=/dev/ttyUSB1           # USB-RS232/RS485 адаптер BMS
BMS_BAUD=9600                   # JBD 9600, Pylontech 115200, Modbus 9600
BMS_UNIT_ID=1                   # Modbus slave id
BMS_INTERVAL=10
BMS_CAN_INTERFACE=can0
BMS_NTC_COUNT=2                 # число датчиков в кадре JBD
BMS_JBD_TEMP=offset40           # offset40 | 0.1k | 0.1k16
# регистры Modbus: {"voltage":[256,0.01],"current":[258,0.1,"s16"],"soc":[260,1]}
BMS_MODBUS=

# ---- automation rules ------------------------------------------------------
AUTOMATION=true
RULES_FILE=/data/rules.json

# ---- notifications (любой набор; пусто = канал выключен) --------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
NOTIFY_MIN_INTERVAL=60          # не чаще одного сообщения в минуту на канал

# ---- PV forecast (forecast.solar, бесплатно) --------------------------------
FORECAST_ENABLED=false
FORECAST_LAT=                  # широта площадки
FORECAST_LON=                  # долгота
FORECAST_KWP=                  # установленная мощность массивов, кВт
FORECAST_DECLINATION=30        # наклон панелей, градусы
FORECAST_AZIMUTH=0             # азимут: 0=юг, -90=восток, 90=запад
FORECAST_INTERVAL=3600

# ---- http api --------------------------------------------------------------
API_PORT=8080
API_BIND=0.0.0.0
API_TOKEN=                          # machine access: "Authorization: Bearer ..."
AUTH_USER=                          # HTTP Basic для UI+API (пусто = без пароля)
AUTH_PASSWORD=
AUTH_FILE=/data/auth.json           # сюда пишется пароль, изменённый в UI (перекрывает AUTH_*)
# HTTPS (опционально): ./tools/gen-cert.sh, затем пути внутри контейнера
TLS_CERT=                           # /certs/server.crt
TLS_KEY=                            # /certs/server.key
PEER_TLS_VERIFY=false               # проверять сертификат соседнего сайта (self-signed -> false)

# ---- secrets (!!! change these) -------------------------------------------
INFLUX_TOKEN=change-me-long-random-token
INFLUX_USER=admin
INFLUX_PASSWORD=change-me-influx-password

GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana-password

# per-firmware command overrides (JSON), e.g.
# SETTINGS_JSON={"max_charge_current":{"cmd":"MCHGC{:03d}"}}
SETTINGS_JSON=

# ---- HTTPS / Grafana за Caddy ----------------------------------------------
API_HTTPS_PORT=8443               # доп. HTTPS-листенер коллектора (HTTP на API_PORT остаётся)
API_HTTPS_HOST_PORT=8443          # порт на хосте
FORCE_HTTPS=false                 # true = только HTTPS (HTTP-листенер не поднимается)

GRAFANA_PROXY_PORT=3443           # https://<host>:3443/ -> Grafana через Caddy
GRAFANA_PROXY_USER=admin
# хэш пароля: docker run --rm caddy:2 caddy hash-password --plaintext '<пароль>'
GRAFANA_PROXY_HASH=
