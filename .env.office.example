# Второй сайт: копия основного .env с другими SITE / MQTT_PREFIX / портами / транспортом.
SITE=office
DEVICE_NAME=Inverter (office)
ENTITY_PREFIX=solar_office

# Импорт из SolarAssistant (её USB-порт занят) либо прямой транспорт:
TRANSPORT=sa-mqtt
SA_MQTT_HOST=192.168.1.134
SA_MQTT_PORT=1883
# TRANSPORT=tcp
# TCP_HOST=192.168.1.134
# TCP_PORT=2000

MQTT_HOST=192.168.31.224
MQTT_PREFIX=solar/office
HA_DISCOVERY=false

INFLUX_MODE=2
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=solar
INFLUX_BUCKET=solar
INFLUX_TOKEN=                    # тот же, что в основном .env

API_PORT=8080
API_HOST_PORT=8081

PEER_SITES={"home":"http://192.168.31.115:8080","office":"http://192.168.31.115:8081"}
